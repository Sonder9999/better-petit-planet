<UserControl x:Class="BetterPetitPlanet.View.Controls.Music.MusicOverlaySettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:music="clr-namespace:BetterPetitPlanet.View.Controls.Music"
             xmlns:vm="clr-namespace:BetterPetitPlanet.ViewModel.Windows"
             d:DataContext="{d:DesignInstance Type=vm:MusicOverlaySettingsViewModel}"
             mc:Ignorable="d">
    <StackPanel>
        <!-- 1. 悬浮谱面总开关 -->
        <Border Margin="0,0,0,12"
                Padding="18"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="36"
                        Height="36"
                        Margin="0,0,12,0"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        CornerRadius="8">
                    <ui:SymbolIcon FontSize="18" Symbol="Desktop24" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="悬浮谱面显示" />
                    <TextBlock Margin="0,2,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="在游戏窗口上方显示原生七轨瀑布流落点谱面与打击判定光效" />
                </StackPanel>

                <ui:ToggleSwitch Grid.Column="2"
                                 VerticalAlignment="Center"
                                 IsChecked="{Binding Enabled, Mode=TwoWay}" />
            </Grid>
        </Border>

        <Border Margin="0,0,0,12" Padding="18"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
            <StackPanel>
                <ui:ToggleSwitch Content="GPU 渲染（实验）" IsChecked="{Binding UseGpuRenderer, Mode=TwoWay}" />
                <TextBlock Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="默认使用 WPF。GPU 支持原生默认皮肤、参考皮肤（如雷电将军）及自定义皮肤的完整特效（含音符、长音、背景、同步线、按键反馈、命中爆发及长按粒子）。其他未迁移参考皮肤、调整布局及 GPU 故障会回退使用 WPF。预览在支持 GPU 时使用 DirectComposition 硬件加速呈现。" />
                <TextBlock Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}"
                           Text="{Binding OverlayBackendDiagnostic}" />
            </StackPanel>
        </Border>

        <!-- 2. 皮肤主题选择与实时预览 -->
        <Border Margin="0,0,0,12"
                Padding="18"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <StackPanel>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="36"
                            Height="36"
                            Margin="0,0,12,0"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            CornerRadius="8">
                        <ui:SymbolIcon FontSize="18" Symbol="PaintBrush24" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="皮肤主题与实时预览" />
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="选择可用皮肤，预览展示七轨原生渲染效果" />
                    </StackPanel>
                </Grid>

                <!-- 预览与皮肤列表按单列排列，窄窗口下仍保留可用宽度 -->
                <StackPanel>
                    <Border Height="520"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            ClipToBounds="True">
                        <Grid>
                            <music:MusicPlayfieldControl x:Name="PlayfieldPreview"
                                                         HorizontalAlignment="Stretch"
                                                         VerticalAlignment="Stretch" />
                            <music:MusicGpuPlayfieldControl x:Name="GpuPlayfieldPreview"
                                                            HorizontalAlignment="Stretch"
                                                            VerticalAlignment="Stretch"
                                                            Visibility="Collapsed" />
                        </Grid>
                    </Border>

                    <!-- 示例播放控制条 -->
                    <Grid Margin="0,10,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:Button Command="{Binding TogglePreviewPlaybackCommand}"
                                   Content="{Binding PreviewPlayButtonText}"
                                   Icon="{ui:SymbolIcon Play24}" />
                        <TextBlock Grid.Column="1"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding PreviewBackendStatus}"
                                   TextWrapping="Wrap" />
                    </Grid>

                    <Border Background="{DynamicResource ControlFillColorInputActiveBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="260" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="6,4,6,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           FontSize="12"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="可用皮肤列表"
                                           Margin="0,0,10,0" />
                                <ui:TextBox Grid.Column="1"
                                            Margin="0,0,8,0"
                                            PlaceholderText="搜索角色或皮肤主题…"
                                            Text="{Binding SkinSearchText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                            ClearButtonEnabled="True"
                                            Icon="{ui:SymbolIcon Search24}"
                                            VerticalAlignment="Center" />
                                <ui:Button x:Name="ImportSkinPackageButton"
                                           Grid.Column="2"
                                           Padding="10,4"
                                           Content="导入 ZIP…"
                                           Click="ImportSkinPackage_Click" />
                            </Grid>

                            <ListBox Grid.Row="1"
                                     x:Name="SkinListBox"
                                     ItemsSource="{Binding FilteredSkins}"
                                     SelectedValue="{Binding SelectedSkinId, Mode=TwoWay}"
                                     SelectedValuePath="Id"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     VirtualizingPanel.ScrollUnit="Pixel"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,0,8" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="CardBorder"
                                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Padding="10"
                                                            Cursor="Hand"
                                                            SnapsToDevicePixels="True">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <!-- 皮肤封面缩略图 -->
                                                            <Border Grid.Column="0"
                                                                    Width="48"
                                                                    Height="48"
                                                                    CornerRadius="6"
                                                                    ClipToBounds="True"
                                                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                                    Margin="0,0,10,0">
                                                                <Image Source="{Binding IconSource}"
                                                                       Stretch="UniformToFill"
                                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                                            </Border>

                                                            <!-- 皮肤标题与说明 -->
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding FullTitle}"
                                                                               FontSize="13"
                                                                               FontWeight="SemiBold"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <Border x:Name="RegionBadge"
                                                                            Margin="8,0,0,0"
                                                                            Padding="5,1"
                                                                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                                            BorderThickness="1"
                                                                            CornerRadius="4"
                                                                            VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Region}"
                                                                                   FontSize="10"
                                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                    </Border>
                                                                </StackPanel>
                                                                <TextBlock Margin="0,3,0,0"
                                                                           Text="{Binding Description}"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           TextWrapping="Wrap"
                                                                           MaxHeight="32" />
                                                            </StackPanel>

                                                            <!-- 绿色胶囊徽章 "使用中" -->
                                                            <Border x:Name="InUseBadge"
                                                                    Grid.Column="2"
                                                                    Visibility="Collapsed"
                                                                    Background="#107C41"
                                                                    CornerRadius="10"
                                                                    Padding="7,2"
                                                                    VerticalAlignment="Center"
                                                                    Margin="6,0,2,0">
                                                                <TextBlock Text="使用中"
                                                                           FontSize="10"
                                                                           FontWeight="Bold"
                                                                           Foreground="White" />
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Region}" Value="{x:Null}">
                                                            <Setter TargetName="RegionBadge" Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Region}" Value="">
                                                            <Setter TargetName="RegionBadge" Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                            <Setter TargetName="CardBorder" Property="BorderThickness" Value="1.5" />
                                                            <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                                            <Setter TargetName="InUseBadge" Property="Visibility" Value="Visible" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Grid>
                    </Border>
                    <TextBlock Margin="6,6,6,0"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{Binding ImportStatusMessage}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 3. 视觉与效果控制（符合图 3 标准配置项） -->
        <Border Margin="0,0,0,12"
                Padding="18"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <StackPanel>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="36"
                            Height="36"
                            Margin="0,0,12,0"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            CornerRadius="8">
                        <ui:SymbolIcon FontSize="18" Symbol="Color24" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="视觉与效果控制" />
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="按键标签、背景装饰、透明度、发光强度与音符流速实时控制" />
                    </StackPanel>
                </Grid>

                <!-- 开关组：按键标签 与 背景装饰 -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 按键标签开关 -->
                    <Border Grid.Column="0"
                            Margin="0,0,6,0"
                            Padding="12"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontWeight="SemiBold" Text="按键标签" />
                                <TextBlock Margin="0,2,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="判定线下方的 A S D F J K L 键帽" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1"
                                             VerticalAlignment="Center"
                                             IsChecked="{Binding ShowKeyLabels, Mode=TwoWay}" />
                        </Grid>
                    </Border>

                    <!-- 背景装饰开关 -->
                    <Border Grid.Column="1"
                            Margin="6,0,0,0"
                            Padding="12"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontWeight="SemiBold" Text="背景装饰" />
                                <TextBlock Margin="0,2,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="显示皮肤拱廊花纹与氛围底色" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1"
                                             VerticalAlignment="Center"
                                             IsChecked="{Binding ShowBackgroundDeco, Mode=TwoWay}" />
                        </Grid>
                    </Border>
                </Grid>

                <Separator Margin="0,0,0,14" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

                <!-- 背景透明度滑块 (0% ~ 100%) -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock FontWeight="Medium" Text="背景透明度" />
                        <TextBlock FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="调节背景拱廊花纹的透光度，设为 0% 时完全透明" />
                    </StackPanel>
                    <TextBlock Grid.Row="0"
                               Grid.Column="1"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Text="{Binding BackgroundOpacity, StringFormat='{}{0:P0}'}" />
                    <Slider Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Margin="0,8,0,0"
                            Maximum="1.0"
                            Minimum="0.0"
                            SmallChange="0.05"
                            TickFrequency="0.05"
                            IsSnapToTickEnabled="True"
                            Value="{Binding BackgroundOpacity, Mode=TwoWay}" />
                </Grid>

                <!-- 特效强度滑块 (0% ~ 100%) -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock FontWeight="Medium" Text="特效强度" />
                        <TextBlock FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="调节打击花朵、判定爆发和按键光效的整体亮度" />
                    </StackPanel>
                    <TextBlock Grid.Row="0"
                               Grid.Column="1"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Text="{Binding Intensity, StringFormat='{}{0:P0}'}" />
                    <Slider Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Margin="0,8,0,0"
                            Maximum="1.0"
                            Minimum="0.1"
                            SmallChange="0.05"
                            TickFrequency="0.05"
                            IsSnapToTickEnabled="True"
                            Value="{Binding Intensity, Mode=TwoWay}" />
                </Grid>

                <!-- 音符流速 / 提前显示时长滑块 (500 ~ 8000 ms) -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock FontWeight="Medium" Text="音符流速 / 提前显示时长" />
                        <TextBlock FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="音符从顶端下落到达判定线的耗时，值越小下落越快 (500–8000 ms)" />
                    </StackPanel>
                    <TextBlock Grid.Row="0"
                               Grid.Column="1"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Text="{Binding FallDurationMs, StringFormat='{}{0} ms'}" />
                    <Slider Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Margin="0,8,0,0"
                            Maximum="8000"
                            Minimum="500"
                            SmallChange="50"
                            TickFrequency="250"
                            IsSnapToTickEnabled="True"
                            Value="{Binding FallDurationMs, Mode=TwoWay}" />
                </Grid>

                <!-- 视觉偏移滑块 (-1000 ~ 1000 ms) -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock FontWeight="Medium" Text="视觉偏移 (Visual Offset)" />
                        <TextBlock FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="校准谱面相对于音频的提前/滞后时间，正数表示谱面向前推进 (-1000–1000 ms)" />
                    </StackPanel>
                    <TextBlock Grid.Row="0"
                               Grid.Column="1"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Text="{Binding VisualOffsetMs, StringFormat='{}{0} ms'}" />
                    <Slider Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Margin="0,8,0,0"
                            Maximum="1000"
                            Minimum="-1000"
                            SmallChange="10"
                            TickFrequency="25"
                            IsSnapToTickEnabled="True"
                            Value="{Binding VisualOffsetMs, Mode=TwoWay}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- 4. 高级效果与引导虚线（折叠卡片） -->
        <ui:CardExpander Margin="0,0,0,12"
                         CornerRadius="8"
                         IsExpanded="False">
            <ui:CardExpander.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="36"
                            Height="36"
                            Margin="0,0,12,0"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            CornerRadius="8">
                        <ui:SymbolIcon FontSize="18" Symbol="Sparkle24" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="高级光效微调" />
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="和弦连线、长按持续光效、命中打击爆发与轨道垂直虚线" />
                    </StackPanel>
                </Grid>
            </ui:CardExpander.Header>

            <StackPanel Margin="0,8,0,4">
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontWeight="Medium" Text="和弦同时按键连线" />
                        <TextBlock FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="在同一时间点的多个音符之间绘制横向发光连线横梁" />
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1"
                                     VerticalAlignment="Center"
                                     IsChecked="{Binding SyncLines, Mode=TwoWay}" />
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontWeight="Medium" Text="长按按键持续高亮" />
                        <TextBlock FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="长按音符在判定线持续发光并随按压保持光效" />
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1"
                                     VerticalAlignment="Center"
                                     IsChecked="{Binding HoldGlow, Mode=TwoWay}" />
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontWeight="Medium" Text="命中打击爆发光效" />
                        <TextBlock FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="音符到达判定线时产生多层粒子花朵与冲击波反馈" />
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1"
                                     VerticalAlignment="Center"
                                     IsChecked="{Binding HitBursts, Mode=TwoWay}" />
                </Grid>

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontWeight="Medium" Text="轨道垂直引导虚线" />
                        <TextBlock FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="在各音轨之间显示轻柔的分界竖线" />
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1"
                                     VerticalAlignment="Center"
                                     IsChecked="{Binding LaneGuides, Mode=TwoWay}" />
                </Grid>
            </StackPanel>
        </ui:CardExpander>

        <!-- 5. 位置与尺寸（折叠卡片） -->
        <ui:CardExpander Margin="0,0,0,12"
                         CornerRadius="8"
                         IsExpanded="False">
            <ui:CardExpander.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="36"
                            Height="36"
                            Margin="0,0,12,0"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            CornerRadius="8">
                        <ui:SymbolIcon FontSize="18" Symbol="ScaleFill24" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="位置与尺寸" />
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="在游戏窗口中微调谱面水平位置、宽度、判定线与整体缩放" />
                    </StackPanel>
                </Grid>
            </ui:CardExpander.Header>

            <StackPanel Margin="0,8,0,4">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <ui:Button Appearance="Primary"
                               Command="{Binding ToggleAdjustmentCommand}"
                               Content="{Binding AdjustButtonText}"
                               Icon="{ui:SymbolIcon ArrowMove24}" />
                    <ui:Button Margin="8,0,0,0"
                               Command="{Binding ResetLayoutCommand}"
                               Content="恢复默认布局" />
                </StackPanel>
                <TextBlock Margin="0,0,0,14"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="提示：点击“调整位置”后将暂停自动输入并在游戏窗口上方激活可拖拽手柄；调整完成后再次点击即可结束保存。"
                           TextWrapping="Wrap" />

                <Separator Margin="0,0,0,12" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" FontWeight="Medium" Text="整体缩放 (Scale)" />
                    <TextBlock Grid.Row="0"
                               Grid.Column="1"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Text="{Binding LayoutScale, StringFormat='{}{0:F2}x'}" />
                    <Slider Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Margin="0,8,0,0"
                            Maximum="2.0"
                            Minimum="0.5"
                            TickFrequency="0.05"
                            IsSnapToTickEnabled="True"
                            Value="{Binding LayoutScale, Mode=TwoWay}" />
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" FontWeight="Medium" Text="判定线纵向位置 (Judgement Line)" />
                    <TextBlock Grid.Row="0"
                               Grid.Column="1"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Text="{Binding JudgementLine, StringFormat='{}{0:P0}'}" />
                    <Slider Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Margin="0,8,0,0"
                            Maximum="1.0"
                            Minimum="0.3"
                            TickFrequency="0.01"
                            IsSnapToTickEnabled="True"
                            Value="{Binding JudgementLine, Mode=TwoWay}" />
                </Grid>
            </StackPanel>
        </ui:CardExpander>

        <!-- 6. 快捷键摘要（只读折叠卡片） -->
        <ui:CardExpander Margin="0,0,0,12"
                         CornerRadius="8"
                         IsExpanded="False">
            <ui:CardExpander.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="36"
                            Height="36"
                            Margin="0,0,12,0"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            CornerRadius="8">
                        <ui:SymbolIcon FontSize="18" Symbol="Keyboard24" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="快捷键摘要（只读）" />
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="查看当前全局快捷键分配，修改请前往统一快捷键设置页" />
                    </StackPanel>
                </Grid>
            </ui:CardExpander.Header>

            <Grid Margin="0,8,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Margin="0,0,6,8" Padding="12" Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="6">
                    <StackPanel>
                        <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="自动拾取总开关" />
                        <TextBlock Margin="0,2,0,0" FontSize="14" FontWeight="SemiBold" Text="{Binding HotkeyAutoPick}" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" Margin="6,0,0,8" Padding="12" Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="6">
                    <StackPanel>
                        <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="自动演奏启动/暂停" />
                        <TextBlock Margin="0,2,0,0" FontSize="14" FontWeight="SemiBold" Text="{Binding HotkeyAutoPlay}" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" Margin="0,0,6,8" Padding="12" Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="6">
                    <StackPanel>
                        <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="谱面时间轴启停 (跟弹)" />
                        <TextBlock Margin="0,2,0,0" FontSize="14" FontWeight="SemiBold" Text="{Binding HotkeyTimeline}" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" Margin="6,0,0,8" Padding="12" Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="6">
                    <StackPanel>
                        <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="悬浮谱面显隐开关" />
                        <TextBlock Margin="0,2,0,0" FontSize="14" FontWeight="SemiBold" Text="{Binding HotkeyOverlay}" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Grid.Column="0" Margin="0,0,6,0" Padding="12" Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="6">
                    <StackPanel>
                        <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="上一首歌曲" />
                        <TextBlock Margin="0,2,0,0" FontSize="14" FontWeight="SemiBold" Text="{Binding HotkeyPrevSong}" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Grid.Column="1" Margin="6,0,0,0" Padding="12" Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="6">
                    <StackPanel>
                        <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="下一首歌曲" />
                        <TextBlock Margin="0,2,0,0" FontSize="14" FontWeight="SemiBold" Text="{Binding HotkeyNextSong}" />
                    </StackPanel>
                </Border>
            </Grid>
        </ui:CardExpander>

        <!-- 7. 底部状态与操作栏 -->
        <Border Margin="0,0,0,12"
                Padding="16"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="13"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="SkinDiagnosticText" Margin="0,3,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                               Text="{Binding SkinDiagnostic}"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="OverlaySkinDiagnosticText" Margin="0,3,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                               Text="{Binding OverlaySkinDiagnostic, StringFormat='浮层：{0}'}"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,3,0,0"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                               Text="{Binding ValidationError}"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasValidationError}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Margin="0,0,8,0"
                               Command="{Binding ResetToDefaultCommand}"
                               Content="重置为默认" />
                    <ui:Button Appearance="Primary"
                               Command="{Binding ApplyCommand}"
                               Content="应用谱面设置"
                               IsEnabled="{Binding IsDirty}" />
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
