<ui:FluentWindow x:Class="BetterPetitPlanet.View.Windows.MusicSettingsWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                   xmlns:music="clr-namespace:BetterPetitPlanet.View.Controls.Music"
                   xmlns:viewModel="clr-namespace:BetterPetitPlanet.ViewModel.Pages"
                   Title="演奏设置"
                   Width="700"
                   Height="680"
                   MinWidth="540"
                   MinHeight="480"
                   ExtendsContentIntoTitleBar="True"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                   WindowBackdropType="Mica"
                   WindowStartupLocation="CenterOwner"
                   mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="演奏设置">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Settings24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ScrollViewer Grid.Row="1"
                      Margin="24,12,24,20"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 1. 播放速度与节奏卡片 -->
                <Border Margin="0,0,0,12"
                        Padding="18"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="36"
                                    Height="36"
                                    Margin="0,0,12,0"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    CornerRadius="8">
                                <ui:SymbolIcon FontSize="18" Symbol="Gauge24" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock FontSize="15" FontWeight="SemiBold" Text="播放速度与倍率" />
                                <TextBlock Margin="0,2,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="全局调节演奏播放速率，支持从 0.5x 到 2.0x 精确变速" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <Slider VerticalAlignment="Center"
                                    Maximum="2.0"
                                    Minimum="0.5"
                                    TickFrequency="0.05"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding PlaybackSpeed, Mode=TwoWay}" />
                            <TextBlock Grid.Column="1"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Text="{Binding PlaybackSpeed, StringFormat='{}{0:F2}x'}" />
                        </Grid>

                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <ui:Button Margin="0,0,8,0" Command="{Binding SetPresetSpeedCommand}" CommandParameter="0.8" Content="0.8x" />
                            <ui:Button Margin="0,0,8,0" Command="{Binding SetPresetSpeedCommand}" CommandParameter="1.0" Content="1.0x (原速)" />
                            <ui:Button Margin="0,0,8,0" Command="{Binding SetPresetSpeedCommand}" CommandParameter="1.25" Content="1.25x" />
                            <ui:Button Command="{Binding SetPresetSpeedCommand}" CommandParameter="1.5" Content="1.5x" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 2. 演奏方式与准备倒计时卡片 -->
                <Border Margin="0,0,0,12"
                        Padding="18"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="36"
                                    Height="36"
                                    Margin="0,0,12,0"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    CornerRadius="8">
                                <ui:SymbolIcon FontSize="18" Symbol="MusicNote224" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock FontSize="15" FontWeight="SemiBold" Text="演奏方式与准备时长" />
                                <TextBlock Margin="0,2,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="选择全自动模拟输入或手动跟弹练习，并设置起奏前等待时长" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,16,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontWeight="Medium" Text="自动演奏模式 (关闭后进入手动跟弹)" />
                                <TextBlock FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="开启后由程序驱动击键；关闭后仅推进节拍与瀑布流谱面，不模拟发键" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1"
                                             VerticalAlignment="Center"
                                             IsChecked="{Binding AutomaticPlaybackEnabled, Mode=TwoWay}" />
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                                <TextBlock FontWeight="Medium" Text="演奏起奏准备时长" />
                                <TextBlock FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="点击播放后倒计时等待时长，便于在演奏开始前切换到游戏并摆正手位" />
                            </StackPanel>
                            <TextBlock Grid.Row="0"
                                       Grid.Column="1"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Text="{Binding PreparationMs, StringFormat='{}{0} ms'}" />
                            <Slider Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    Margin="0,8,0,0"
                                    Maximum="8000"
                                    Minimum="0"
                                    TickFrequency="500"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding PreparationMs, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 3. 按键输入与焦点策略卡片 -->
                <Border Margin="0,0,0,12"
                        Padding="18"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="36"
                                    Height="36"
                                    Margin="0,0,12,0"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    CornerRadius="8">
                                <ui:SymbolIcon FontSize="18" Symbol="Keyboard24" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock FontSize="15" FontWeight="SemiBold" Text="按键输入与焦点策略" />
                                <TextBlock Margin="0,2,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="配置演奏时按键模拟方式和窗口焦点保护" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,16,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontWeight="Medium" Text="游戏失去焦点时自动暂停" />
                                <TextBlock FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="切换到其他窗口时暂停演奏，避免在聊天框或其他应用误输入" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1"
                                             VerticalAlignment="Center"
                                             IsChecked="{Binding AutoPauseOnFocusLost, Mode=TwoWay}" />
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontWeight="Medium" Text="鼠标输入模式" />
                                <TextBlock FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="开启后使用鼠标直接点击游戏内的乐器音符；关闭后使用键盘按键演奏" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1"
                                             VerticalAlignment="Center"
                                             IsChecked="{Binding IsMouseInput, Mode=TwoWay}" />
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontWeight="Medium" Text="操作后自动激活游戏窗口" />
                                <TextBlock FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="拖拽进度条或点击播放等控制操作后，自动将系统键盘焦点返还给游戏客户端" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1"
                                             VerticalAlignment="Center"
                                             IsChecked="{Binding AutoFocusGameOnPlayback, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 4. 内嵌悬浮谱面设置卡片及小预览 -->
                <music:MusicOverlaySettingsControl x:Name="OverlaySettingsControl" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
