<ui:FluentWindow x:Class="BetterPetitPlanet.View.Windows.MusicSettingsWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:viewModel="clr-namespace:BetterPetitPlanet.ViewModel.Pages"
                  Title="演奏设置"
                  Width="680"
                  Height="540"
                  MinWidth="540"
                  MinHeight="400"
                  ExtendsContentIntoTitleBar="True"
                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                  WindowBackdropType="Mica"
                  WindowStartupLocation="CenterOwner"
                  mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="演奏设置">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Settings24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ScrollViewer Grid.Row="1"
                      Margin="24,12,24,20"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 播放速度与节奏卡片 -->
                <Border Margin="0,0,0,12"
                        Padding="18"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="36"
                                    Height="36"
                                    Margin="0,0,12,0"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    CornerRadius="8">
                                <ui:SymbolIcon FontSize="18" Symbol="Gauge24" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock FontSize="15" FontWeight="SemiBold" Text="播放速度与倍率" />
                                <TextBlock Margin="0,2,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="全局调节演奏播放速率，支持从 0.5x 到 2.0x 精确变速" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <Slider VerticalAlignment="Center"
                                    Maximum="2.0"
                                    Minimum="0.5"
                                    TickFrequency="0.05"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding PlaybackSpeed, Mode=TwoWay}" />
                            <TextBlock Grid.Column="1"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Text="{Binding PlaybackSpeed, StringFormat='{}{0:F2}x'}" />
                        </Grid>

                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <ui:Button Margin="0,0,8,0" Command="{Binding SetPresetSpeedCommand}" CommandParameter="0.8" Content="0.8x" />
                            <ui:Button Margin="0,0,8,0" Command="{Binding SetPresetSpeedCommand}" CommandParameter="1.0" Content="1.0x (原速)" />
                            <ui:Button Margin="0,0,8,0" Command="{Binding SetPresetSpeedCommand}" CommandParameter="1.25" Content="1.25x" />
                            <ui:Button Command="{Binding SetPresetSpeedCommand}" CommandParameter="1.5" Content="1.5x" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 输入与焦点控制卡片 -->
                <Border Margin="0,0,0,12"
                        Padding="18"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="36"
                                    Height="36"
                                    Margin="0,0,12,0"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    CornerRadius="8">
                                <ui:SymbolIcon FontSize="18" Symbol="Keyboard24" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock FontSize="15" FontWeight="SemiBold" Text="按键输入与焦点策略" />
                                <TextBlock Margin="0,2,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="配置演奏时按键模拟方式和窗口焦点保护" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,16,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontWeight="Medium" Text="游戏失去焦点时自动暂停" />
                                <TextBlock FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="切换到其他窗口时暂停演奏，避免在聊天框或其他应用误输入" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1"
                                             VerticalAlignment="Center"
                                             IsChecked="{Binding AutoPauseOnFocusLost, Mode=TwoWay}" />
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontWeight="Medium" Text="鼠标输入模式" />
                                <TextBlock FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="开启后使用鼠标直接点击游戏内的竖笛音符；关闭后使用键盘按键演奏" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1"
                                             VerticalAlignment="Center"
                                             IsChecked="{Binding IsMouseInput, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
