<ui:FluentWindow x:Class="BetterPetitPlanet.View.Windows.InstrumentNotReadyDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  Title="星布谷地 - 乐器未就绪"
                  Width="480"
                  Height="260"
                  MinWidth="480"
                  MinHeight="260"
                  MaxWidth="480"
                  MaxHeight="260"
                  ResizeMode="NoResize"
                  ExtendsContentIntoTitleBar="True"
                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                  WindowBackdropType="Mica"
                  WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="星布谷地 - 乐器未就绪">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Warning24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- 内容提示区 -->
        <StackPanel Grid.Row="1" Margin="24,8,24,12" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Border Width="38" Height="38" Background="#26D83B01" CornerRadius="8" Margin="0,0,12,0" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="MusicNote2Play20" FontSize="20" Foreground="#FFD83B01" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="未在游戏中检测到竖笛演奏界面" />
                    <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="请确认是否已在《星布谷地》游戏中拿出竖笛" />
                </StackPanel>
            </StackPanel>

            <TextBlock FontSize="13" TextWrapping="Wrap" LineHeight="20" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                如果您已在游戏中进入了乐器演奏状态，可以直接点击【继续演奏】强制开始；如需返回游戏拿出竖笛，请点击【确定】。
            </TextBlock>
        </StackPanel>

        <!-- 底部按钮操作栏：最左边是继续演奏，最右边是确定 -->
        <Border Grid.Row="2"
                Padding="24,12"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <!-- 最左边按钮：继续演奏 (Primary 重点样式) -->
                <ui:Button Content="继续演奏"
                           Appearance="Primary"
                           Icon="{ui:SymbolIcon Play24}"
                           Click="OnContinueClick"
                           HorizontalAlignment="Left"
                           Padding="18,6" />

                <!-- 最右边按钮：确定 (Secondary 返回) -->
                <ui:Button Content="确定"
                           Appearance="Secondary"
                           Click="OnConfirmClick"
                           HorizontalAlignment="Right"
                           Padding="24,6" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
