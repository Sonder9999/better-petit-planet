<UserControl x:Class="BetterPetitPlanet.View.Pages.MusicPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behavior="clr-namespace:BetterPetitPlanet.View.Behavior"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:viewModel="clr-namespace:BetterPetitPlanet.ViewModel.Pages"
             d:DataContext="{d:DesignInstance Type=viewModel:MusicPageViewModel}"
             d:DesignHeight="800"
             d:DesignWidth="1180"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="MusicCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="18" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <Style x:Key="MusicListItemStyle" TargetType="ListViewItem">
            <Setter Property="Margin" Value="2,1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="ItemBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlaybackTrackButtonStyle" TargetType="RepeatButton">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                            <Border x:Name="Indicator"
                                    Height="4"
                                    VerticalAlignment="Center"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="3" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Slider}}}" Value="True">
                                <Setter TargetName="Indicator" Property="Height" Value="6" />
                            </DataTrigger>
                            <Trigger Property="Tag" Value="Played">
                                <Setter TargetName="Indicator" Property="Margin" Value="10,0,-10,0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlaybackSliderThumbStyle" TargetType="Thumb">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="Halo"
                                     Width="20"
                                     Height="20"
                                     Fill="Transparent"
                                     Stroke="{DynamicResource AccentFillColorDefaultBrush}"
                                     StrokeThickness="2"
                                     Opacity="0" />
                            <Ellipse x:Name="ThumbSurface"
                                     Width="12"
                                     Height="12"
                                     Fill="{DynamicResource AccentFillColorDefaultBrush}"
                                     Stroke="#FFF8FBFF"
                                     StrokeThickness="1.5">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="4"
                                                      Color="#000000"
                                                      Opacity="0.2"
                                                      ShadowDepth="1" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Halo" Property="Opacity" Value="0.22" />
                                <Setter TargetName="ThumbSurface" Property="Width" Value="14" />
                                <Setter TargetName="ThumbSurface" Property="Height" Value="14" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Halo" Property="Opacity" Value="0.36" />
                                <Setter TargetName="ThumbSurface" Property="Width" Value="16" />
                                <Setter TargetName="ThumbSurface" Property="Height" Value="16" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlaybackSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="26" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid x:Name="SliderRoot"
                              Background="{TemplateBinding Background}"
                              SnapsToDevicePixels="True">
                            <Border x:Name="TrackBackground"
                                    Height="4"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource ControlStrongFillColorDefaultBrush}"
                                    CornerRadius="3"
                                    Opacity="0.38" />
                            <Track x:Name="PART_Track"
                                   Height="20"
                                   Margin="-10,0"
                                   VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}"
                                                  Style="{StaticResource PlaybackTrackButtonStyle}"
                                                  Tag="Played">
                                        <RepeatButton.Background>
                                            <SolidColorBrush Color="{DynamicResource SystemAccentColorSecondary}" />
                                        </RepeatButton.Background>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource PlaybackSliderThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}"
                                                  Background="Transparent"
                                                  Style="{StaticResource PlaybackTrackButtonStyle}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TrackBackground" Property="Height" Value="6" />
                                <Setter TargetName="TrackBackground" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 上方曲库主面板 (Screenshot 2 对齐) -->
        <Grid Grid.Row="0" Margin="24,10,24,10">
            <Border Padding="0" Style="{StaticResource MusicCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Row 0: 顶部标题与目录操作按钮 -->
                    <Grid Margin="16,12,12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock VerticalAlignment="Center"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Text="我的曲库" />

                        <TextBlock Grid.Column="1"
                                   Margin="14,0"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding SongsDirectory}">
                            <Run Text="曲谱目录：" />
                            <Run Text="{Binding MusicFolderDisplayText, Mode=OneWay}" />
                        </TextBlock>

                        <ui:Button Grid.Column="2"
                                   Width="36"
                                   Height="34"
                                   Margin="0,0,7,0"
                                   Command="{Binding OpenFolderCommand}"
                                   Icon="{ui:SymbolIcon Open24}"
                                   ToolTip="打开当前目录" />

                        <ui:Button Grid.Column="3"
                                   Height="34"
                                   Margin="0,0,7,0"
                                   Appearance="Primary"
                                   Command="{Binding SelectDirectoryCommand}"
                                   Content="选择目录"
                                   Icon="{ui:SymbolIcon FolderOpen24}" />

                        <ui:Button Grid.Column="4"
                                   Height="34"
                                   Margin="0,0,7,0"
                                   Command="{Binding DeleteMusicFolderCommand}"
                                   Content="删除记录"
                                   Icon="{ui:SymbolIcon Delete24}" />

                        <ui:Button Grid.Column="5"
                                   Height="34"
                                   Command="{Binding OpenSettingsCommand}"
                                   Content="设置"
                                   Icon="{ui:SymbolIcon Settings24}" />
                    </Grid>

                    <!-- Row 1: 筛选与搜索工具条 -->
                    <Grid Grid.Row="1" Margin="12,0,12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>

                        <ui:TextBox Grid.Column="0"
                                    Margin="0,0,8,0"
                                    PlaceholderText="搜索曲名、作者或路径"
                                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                        <ComboBox Grid.Column="1"
                                  Margin="0,0,8,0"
                                  ItemsSource="{Binding AvailableFormats}"
                                  SelectedItem="{Binding SelectedFormat, Mode=TwoWay}"
                                  ToolTip="按格式筛选" />

                        <ComboBox Grid.Column="2"
                                  Margin="0,0,8,0"
                                  ItemsSource="{Binding AvailableInstruments}"
                                  SelectedItem="{Binding SelectedInstrument, Mode=TwoWay}"
                                  ToolTip="按乐器筛选" />

                        <ui:Button Grid.Column="3"
                                   Width="44"
                                   Height="34"
                                   Command="{Binding RefreshSongsCommand}"
                                   ToolTip="重新扫描曲谱目录">
                            <Grid Width="18" Height="18">
                                <ui:SymbolIcon Symbol="ArrowClockwise24"
                                               Visibility="{Binding IsRefreshing, Converter={StaticResource BooleanToVisibilityRevertConverter}}" />
                                <ui:ProgressRing Width="18"
                                                 Height="18"
                                                 IsIndeterminate="True"
                                                 Visibility="{Binding IsRefreshing, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                        </ui:Button>
                    </Grid>

                    <!-- Row 2: 乐曲列表与空状态 -->
                    <Grid Grid.Row="2" Margin="8,0,8,8">
                        <ListView x:Name="MusicListView"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  ItemContainerStyle="{StaticResource MusicListItemStyle}"
                                  ItemsSource="{Binding Songs}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  SelectedItem="{Binding SelectedSong, Mode=TwoWay}">
                            <b:Interaction.Triggers>
                                <b:EventTrigger EventName="MouseDoubleClick">
                                    <b:InvokeCommandAction Command="{Binding PlaySelectedCommand}"
                                                           CommandParameter="{Binding SelectedItem, ElementName=MusicListView}" />
                                </b:EventTrigger>
                            </b:Interaction.Triggers>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="70" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="30"
                                                Height="30"
                                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                CornerRadius="6">
                                            <ui:SymbolIcon FontSize="16" Symbol="MusicNote216" />
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <TextBlock FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                       Text="{Binding Title}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Artist}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <Border Grid.Column="2"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Padding="8,2"
                                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                CornerRadius="4">
                                            <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Instrument}" />
                                        </Border>

                                        <TextBlock Grid.Column="3"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="{Binding Bpm, StringFormat='BPM {0}'}" />

                                        <TextBlock Grid.Column="4"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Text="{Binding Duration}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- 空状态展示 -->
                        <Border IsHitTestVisible="False">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Songs.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="64"
                                        Height="64"
                                        HorizontalAlignment="Center"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                        CornerRadius="20">
                                    <ui:SymbolIcon FontSize="30" Symbol="MusicNote224" />
                                </Border>
                                <TextBlock Margin="0,16,0,0"
                                           HorizontalAlignment="Center"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           Text="曲库还是空的" />
                                <TextBlock MaxWidth="320"
                                           Margin="0,7,0,0"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="尚未选择有效的曲谱目录，点击右上角“选择目录”导入乐谱"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 下方高保真播放控制器 (Screenshot 2 对齐) -->
        <Border Grid.Row="1"
                MinHeight="96"
                Padding="0"
                BorderThickness="0,1,0,0"
                CornerRadius="0"
                Style="{StaticResource MusicCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 顶部无缝吸附进度滑块 -->
                <Slider Height="26"
                        Margin="0,-13,0,0"
                        Panel.ZIndex="2"
                        VerticalAlignment="Top"
                        Maximum="{Binding TotalDuration}"
                        Minimum="0"
                        Style="{StaticResource PlaybackSliderStyle}"
                        Value="{Binding CurrentPosition, Mode=TwoWay}">
                    <b:Interaction.Behaviors>
                        <behavior:SliderSeekBehavior BeginCommand="{Binding BeginSeekCommand}"
                                                     Command="{Binding SeekCommand}" />
                    </b:Interaction.Behaviors>
                </Slider>

                <!-- 时间显示条 -->
                <Grid Margin="20,5,20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="50" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{Binding CurrentTimeText}" />
                    <TextBlock Grid.Column="2"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{Binding TotalTimeText}" />
                </Grid>

                <!-- 控制器操作区 -->
                <Grid Grid.Row="1" Margin="20,4,20,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：正在播放信息 -->
                    <StackPanel MinWidth="180"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <Border Width="46"
                                Height="46"
                                Margin="0,0,12,0"
                                Background="{DynamicResource AccentFillColorDefaultBrush}"
                                CornerRadius="12">
                            <ui:SymbolIcon FontSize="22"
                                           Foreground="White"
                                           Symbol="MusicNote224" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock MaxWidth="190"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           Text="{Binding CurrentSongTitle}"
                                           TextTrimming="CharacterEllipsis" />
                                <Border Margin="8,0,0,0"
                                        Padding="6,1"
                                        VerticalAlignment="Center"
                                        Background="#15808080"
                                        CornerRadius="4">
                                    <TextBlock FontSize="10"
                                               FontWeight="Medium"
                                               Foreground="{Binding InstrumentStatusColor}"
                                               Text="{Binding InstrumentStatusText}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Margin="0,3,0,0"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{Binding CurrentSongSubtitle}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 中间：核心播放操作组 -->
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <ui:Button Width="42"
                                   Height="42"
                                   Margin="3,0"
                                   Appearance="Secondary"
                                   Command="{Binding PreviousTrackCommand}"
                                   Icon="{ui:SymbolIcon Previous24}"
                                   ToolTip="上一首" />
                        <ui:Button Width="50"
                                   Height="50"
                                   Margin="4,0"
                                   Appearance="Primary"
                                   Command="{Binding TogglePlayCommand}"
                                   ToolTip="播放/暂停">
                            <ui:SymbolIcon FontSize="22" Symbol="{Binding PlayPauseSymbol}" />
                        </ui:Button>
                        <ui:Button Width="42"
                                   Height="42"
                                   Margin="3,0"
                                   Appearance="Secondary"
                                   Command="{Binding NextTrackCommand}"
                                   Icon="{ui:SymbolIcon Next24}"
                                   ToolTip="下一首" />
                        <ui:Button Width="42"
                                   Height="42"
                                   Margin="3,0"
                                   Appearance="Transparent"
                                   Command="{Binding StopCommand}"
                                   Icon="{ui:SymbolIcon Stop24}"
                                   ToolTip="停止" />
                    </StackPanel>

                    <!-- 右侧：模式与输入方式开关 -->
                    <StackPanel Grid.Column="2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <ui:Button Width="42"
                                   Height="38"
                                   Appearance="Transparent"
                                   Command="{Binding CyclePlaybackModeCommand}"
                                   ToolTip="{Binding PlaybackModeToolTip}">
                            <ui:SymbolIcon FontSize="18" Symbol="{Binding PlaybackModeSymbol}" />
                        </ui:Button>
                        <TextBlock Margin="12,0,6,0"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="输入方式" />
                        <TextBlock Width="28"
                                   Margin="0,0,6,0"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Text="{Binding InputModeDisplayText}" />
                        <ui:ToggleSwitch VerticalAlignment="Center"
                                         IsChecked="{Binding IsMouseInput, Mode=TwoWay}"
                                         ToolTip="开启后使用鼠标直接点击游戏内的竖笛音符；关闭后使用键盘按键演奏" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
