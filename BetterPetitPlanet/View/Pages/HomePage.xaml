<Page x:Class="BetterPetitPlanet.View.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:viewModel="clr-namespace:BetterPetitPlanet.ViewModel.Pages"
      Title="HomePage"
      d:DataContext="{d:DesignInstance Type=viewModel:HomePageViewModel}"
      mc:Ignorable="d">
    <StackPanel Margin="42,16,42,12">
        <!-- 顶部官方视觉 Banner 卡片 (纯远程链接流式加载，支持官网更新自适应与四角圆角裁切) -->
        <Border x:Name="BannerCard"
                Height="200"
                Margin="0,0,0,16"
                CornerRadius="8"
                ClipToBounds="True"
                Background="#0D1117"
                SizeChanged="BannerCard_SizeChanged">
            <Grid>
                <!-- 1. 官网实时远景小镇插画 (纯远程 URL 流式加载) -->
                <Image Source="{Binding OfficialBackgroundUrl}"
                       Stretch="UniformToFill"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Opacity="0.85" />

                <!-- 2. 官网实时星空背景层 -->
                <Image Source="{Binding OfficialStarrySkyUrl}"
                       Stretch="UniformToFill"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Opacity="0.65" />

                <!-- 3. 官网实时右侧人物与弯月前景 (底部与卡片平齐，消除突出尖刺) -->
                <Image Source="{Binding OfficialForegroundUrl}"
                       Height="196"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       Margin="0,0,20,0"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" />

                <!-- 4. 左侧优雅渐变蒙版，确保文字高对比度和清爽阅读 -->
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0.0" Color="#F20B0F19" />
                            <GradientStop Offset="0.45" Color="#B80B0F19" />
                            <GradientStop Offset="0.75" Color="#400B0F19" />
                            <GradientStop Offset="1.0" Color="Transparent" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- 5. 标题与说明文字 -->
                <StackPanel Margin="36,0,0,24"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom">
                    <TextBlock FontSize="28"
                               FontWeight="Bold"
                               Foreground="#FFFFFF"
                               Text="BetterPetitPlanet" />
                    <TextBlock Margin="0,4,0,0"
                               FontSize="14"
                               Opacity="0.9"
                               Foreground="#E2E8F0"
                               Text="更好的星布谷地，免费且开源" />
                    <TextBlock Margin="0,8,0,0"
                               FontSize="12"
                               Opacity="0.85">
                        <Hyperlink Command="{Binding GoToWikiUrlCommand}"
                                   Foreground="#38BDF8"
                                   TextDecorations="None">
                            <Run Text="点击查看文档与教程" />
                            <Run Text=" ›" />
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

            <!-- 截图器启动卡片 -->
            <ui:CardExpander Margin="0,0,0,12"
                             ContentPadding="0"
                             Icon="{ui:SymbolIcon Play24}"
                             IsExpanded="False">
                <ui:CardExpander.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   FontSize="14"
                                   FontWeight="Medium"
                                   Text="BetterPetitPlanet 截图器，启动！" />
                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Margin="0,3,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                            <Run Text="截图器启动后才能使用各项功能，" />
                            <Run FontWeight="Bold"
                                 Text="点击展开启动相关配置"
                                 TextDecorations="Underline" />
                            <Run Text="。" />
                        </TextBlock>
                        <StackPanel Grid.Row="0"
                                    Grid.RowSpan="2"
                                    Grid.Column="1"
                                    Margin="0,0,12,0"
                                    Orientation="Horizontal">
                            <ui:Button Appearance="Primary"
                                       Command="{Binding ToggleCaptureCommand}"
                                       Content="{Binding CaptureButtonText}"
                                       Icon="{ui:SymbolIcon Play24}" />
                        </StackPanel>
                    </Grid>
                </ui:CardExpander.Header>

                <StackPanel>
                    <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                    <!-- 截图模式 -->
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   FontWeight="Medium"
                                   Text="截图模式" />
                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Margin="0,3,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="推荐选择 WindowsGraphicsCapture；带*的模式在当前游戏环境下不可用" />
                        <ComboBox Grid.Row="0"
                                  Grid.RowSpan="2"
                                  Grid.Column="1"
                                  Width="230"
                                  Margin="0,0,12,0"
                                  ItemsSource="{Binding AvailableCaptureModes}"
                                  SelectedItem="{Binding CaptureMode, Mode=TwoWay}" />
                    </Grid>

                    <Separator Margin="-18,0" BorderThickness="0,1,0,0" />

                    <!-- 触发器间隔 -->
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   FontWeight="Medium"
                                   Text="触发器间隔（毫秒）" />
                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Margin="0,3,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="默认 50ms，普通用户不建议调整这个值" />
                        <ui:TextBox Grid.Row="0"
                                    Grid.RowSpan="2"
                                    Grid.Column="1"
                                    MinWidth="90"
                                    Margin="0,0,12,0"
                                    Text="{Binding TriggerInterval, Mode=TwoWay}" />
                    </Grid>

                    <Separator Margin="-18,0" BorderThickness="0,1,0,0" />

                    <!-- AI推理设备设置 -->
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   FontWeight="Medium"
                                   Text="AI推理设备设置" />
                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Margin="0,3,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="DirectML GPU 模式支持全品牌显卡硬件加速；修改后立即生效" />
                        <ComboBox Grid.Row="0"
                                  Grid.RowSpan="2"
                                  Grid.Column="1"
                                  Width="140"
                                  Margin="0,0,8,0"
                                  ItemsSource="{Binding AvailableInferenceDevices}"
                                  SelectedItem="{Binding InferenceDevice, Mode=TwoWay}" />
                        <ui:Button Grid.Row="0"
                                   Grid.RowSpan="2"
                                   Grid.Column="2"
                                   Margin="0,0,12,0"
                                   Content="更多..." />
                    </Grid>

                    <Separator Margin="-18,0" BorderThickness="0,1,0,0" />

                    <!-- 测试图像捕获 -->
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   FontWeight="Medium"
                                   Text="测试图像捕获" />
                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Margin="0,3,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="测试功能，测试当前捕获模式与星布谷地游戏画面的连接情况" />
                        <ui:Button Grid.Row="0"
                                   Grid.RowSpan="2"
                                   Grid.Column="1"
                                   Margin="0,0,12,0"
                                   Command="{Binding StartCaptureTestCommand}"
                                   Content="测试图像捕获" />
                    </Grid>
                </StackPanel>
            </ui:CardExpander>

            <!-- 同时启动星布谷地 -->
            <ui:CardExpander Margin="0,0,0,12"
                             ContentPadding="0"
                             Icon="{ui:SymbolIcon LinkSquare24}">
                <ui:CardExpander.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   FontSize="14"
                                   FontWeight="Medium"
                                   Text="同时启动星布谷地" />
                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Margin="0,3,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="启动截图器时，如果星布谷地未启动，则自动启动星布谷地。" />
                        <ui:ToggleSwitch Grid.Row="0"
                                         Grid.RowSpan="2"
                                         Grid.Column="1"
                                         Margin="0,0,12,0"
                                         IsChecked="{Binding AutoStartGame, Mode=TwoWay}" />
                    </Grid>
                </ui:CardExpander.Header>

                <StackPanel>
                    <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                    <!-- 星布谷地安装位置 -->
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   FontWeight="Medium"
                                   Text="星布谷地安装位置" />
                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Margin="0,3,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="{Binding GameExecutablePath}"
                                   TextWrapping="Wrap" />
                        <ui:Button Grid.Row="0"
                                   Grid.RowSpan="2"
                                   Grid.Column="1"
                                   Margin="0,0,12,0"
                                   Command="{Binding BrowseGamePathCommand}"
                                   Content="浏览" />
                    </Grid>

                    <Separator Margin="-18,0" BorderThickness="0,1,0,0" />

                    <!-- 启动参数 -->
                    <Grid Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock FontWeight="Medium" Text="启动参数" />
                            <TextBlock Margin="0,3,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="如果你不知道什么是启动参数请不要填写。" />
                        </StackPanel>
                        <ui:TextBox Grid.Column="1"
                                    Width="260"
                                    Margin="0,0,12,0"
                                    PlaceholderText="示例：-screen-width 1920"
                                    Text="{Binding GameStartArgs, Mode=TwoWay}" />
                    </Grid>

                    <Separator Margin="-18,0" BorderThickness="0,1,0,0" />

                    <!-- 自动进入游戏 -->
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   FontWeight="Medium"
                                   Text="自动进入游戏" />
                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Margin="0,3,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="星布谷地启动后自动进入游戏主场景" />
                        <ui:ToggleSwitch Grid.Row="0"
                                         Grid.RowSpan="2"
                                         Grid.Column="1"
                                         Margin="0,0,12,0"
                                         IsChecked="{Binding AutoEnterGameEnabled, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </ui:CardExpander>

            <!-- BetterPetitPlanet 桌面分身 -->
            <ui:CardControl Margin="0,0,0,12"
                            Icon="{ui:SymbolIcon DesktopCursor24}">
                <ui:CardControl.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   FontSize="14"
                                   FontWeight="Medium"
                                   Text="BetterPetitPlanet 桌面分身 / 后台运行" />
                        <TextBlock Grid.Row="1"
                                   Margin="0,3,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="游戏在桌面分身或后台中运行时，可以不占用当前桌面鼠标。" />
                    </Grid>
                </ui:CardControl.Header>
                <ui:Button Margin="0,0,12,0"
                           Command="{Binding OpenChildSessionWindowCommand}"
                           Content="打开"
                           Icon="{ui:SymbolIcon Open24}" />
            </ui:CardControl>
        </StackPanel>
</Page>
